// 如果 cmd + p 變成了insert: cmd + opt + o
{
	// 這個在存擋的時候會執行 eslint_fix 但不會再存一次
	"on_post_save_user": [{ "command": "eslint_fix", }],

	"always_show_minimap_viewport": true,
	"auto_complete_triggers": [
		{
			"characters": "<",
			"selector": "text.html",
		},
		{
			"characters": ".",
			"selector": "source.js",
		}
	],
	"binary_file_patterns": [
		// "*.jpg",
		"*.jpeg",
		"*.png",
		"*.webp",

		"*.gif",
		"*.ttf",
		"*.tga",
		"*.dds",
		// "*.ico",
		"*.eot",
		"*.pdf",
		"*.swf",
		"*.jar",
		"*.zip",
		"*.min.js",
		"*-min.js",
		"chunk-libs.js",
		"*.map",
		"*.woff2",
		"*.exe",
		"*.mp4",
		"*.mp4.part"
	],
	"caret_extra_bottom": 2,
	"caret_extra_top": 2,
	"caret_extra_width": 1,
	"color_scheme": "Celeste.sublime-color-scheme",
	"esversion": 6,
	"file_exclude_patterns": [
		"*.pyc",
		"*.pyo",
		"*.dll",
		"*.obj",
		"*.o",
		"*.a",
		"*.lib",
		"*.so",
		"*.dylib",
		"*.ncb",
		"*.sdf",
		"*.suo",
		"*.pdb",
		"*.idb",
		".DS_Store",
		"*.class",
		"*.psd",
		"*.db",
		"*.sublime-workspace"
	],
	"folder_exclude_patterns": [
		".svn",
		".git",
		".hg",
		"CVS",
		"build/out",
		"build",
		"node_modules",
		"yarn.lock",
		"vendor",
		"dist",
		".pnpm-store",
		".nuxt"
	],
	// "font_face": "Monaco",
	"ignored_packages": [
		"Element UI Snippets",
		"Nodejs",
		"React Templates",
		"Vintage",
	],
	"scroll_past_end": true,
	"show_definitions": false,
	"show_encoding": true,
	"show_full_path": true,
	"font_size": 14,
	"tab_size": 2,
	"theme": "Adaptive.sublime-theme",
	"translate_tabs_to_spaces": true,
	// "trim_trailing_white_space_on_save": "all",
	"trim_trailing_white_space_on_save": "none",
	"relative_line_numbers": false,
	"original_color_scheme": "Packages/Colorsublime - Themes/cache/Colorsublime-Themes-master/themes/Foggy-Morning.tmTheme",
	"show_panel_on_build": false,
	"index_files": false,
}
