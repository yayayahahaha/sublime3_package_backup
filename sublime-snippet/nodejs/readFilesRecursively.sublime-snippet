function readFilesRecursively(pathStr, list = []) {
  fs.readdirSync(pathStr).forEach(name => {
    const fullPath = path.join(pathStr, name)
    isDir(fullPath) ? readFilesRecursively(fullPath, list) : list.push(fullPath)
  })
  return list
}
